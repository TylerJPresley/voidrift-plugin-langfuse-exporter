{
  "name": "@voidrift/plugin-langfuse-exporter",
  "version": "0.1.0",
  "description": "VoidRift Langfuse exporter — maps the core's neutral ObsRecord stream onto Langfuse's trace/observation/generation model (langfuse-exporter-blueprint §1).",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest --run",
    "lint": "eslint src"
  },
  "peerDependencies": {
    "@voidrift/core": "^0.1.0"
  },
  "dependencies": {
    "@langfuse/langchain": "5.13.1",
    "@langfuse/tracing": "5.13.1"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@voidrift/core": "^0.1.0",
    "typescript": "5.9.3",
    "vitest": "5.0.3",
    "eslint": "10.12.0",
    "eslint-config-prettier": "10.1.8",
    "typescript-eslint": "8.71.1"
  },
  "voidrift": {
    "kind": "plugin",
    "plugin": true,
    "description": "Carries the core's neutral observability stream to a Langfuse project: one ObsExporter mapping each ObsRecord onto Langfuse's trace/observation/generation model (langfuse-exporter-blueprint §1)."
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TylerJPresley/voidrift-plugin-langfuse-exporter.git"
  },
  "bugs": {
    "url": "https://github.com/TylerJPresley/voidrift-plugin-langfuse-exporter/issues"
  },
  "homepage": "https://github.com/TylerJPresley/voidrift-plugin-langfuse-exporter#readme",
  "keywords": [
    "voidrift",
    "langfuse",
    "exporter",
    "maps",
    "core"
  ],
  "publishConfig": {
    "access": "public"
  }
}
